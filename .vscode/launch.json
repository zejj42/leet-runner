{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run this file (a solution.py is judged, with your breakpoints)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug this problem's tests with pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${fileDirname}",
        "-q",
        "-x",
        "-p",
        "no:cacheprovider"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
