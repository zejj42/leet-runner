{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "problems",
    "tests"
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python.terminal.activateEnvironment": false,
  "python-envs.terminal.autoActivationType": "off",
  "python.envFile": "${workspaceFolder}/.env",
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "files.associations": {
    "cases.json": "jsonc"
  },
  "markdown.styles": [
    ".vscode/markdown.css"
  ],
  "markdown.preview.breaks": false,
  "code-runner.executorMap": {
    "python": "\"$workspaceRoot/.venv/bin/python\" -u $fullFileName"
  },
  "code-runner.runInTerminal": false,
  "code-runner.clearPreviousOutput": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.ignoreSelection": true,
  "code-runner.showExecutionMessage": false,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { "scope": "leet.title", "settings": { "fontStyle": "bold" } },
      { "scope": "leet.accepted", "settings": { "foreground": "#2EA043", "fontStyle": "bold" } },
      { "scope": "leet.failed", "settings": { "foreground": "#F85149", "fontStyle": "bold" } },
      { "scope": "leet.label", "settings": { "foreground": "#D4A72C" } },
      { "scope": "leet.dim", "settings": { "foreground": "#8B949E" } }
    ]
  }
}
