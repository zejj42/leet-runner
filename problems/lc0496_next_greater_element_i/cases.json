{
  "function": "nextGreaterElement",
  "params": [
    {"name": "nums1", "type": "integer[]"},
    {"name": "nums2", "type": "integer[]"}
  ],
  "returns": "integer[]",
  "compare": "exact",
  "cases": [
    {"name": "example 1", "args": [[4, 1, 2], [1, 3, 4, 2]], "expected": [-1, 3, -1]},
    {"name": "example 2", "args": [[2, 4], [1, 2, 3, 4]], "expected": [3, -1]},
    {"name": "nums1 and nums2 identical", "args": [[1, 2, 3], [1, 2, 3]], "expected": [2, 3, -1]},
    {"name": "nums1 is a single element", "args": [[3], [5, 3, 1]], "expected": [-1]},
    {"name": "no element has a greater one to its right", "args": [[4, 3], [5, 4, 3, 2, 1]], "expected": [-1, -1]},
    {"name": "every element has a greater one to its right", "args": [[1, 2, 3], [1, 2, 3, 4]], "expected": [2, 3, 4]},
    {"name": "nums1 in reverse order of nums2", "args": [[4, 3, 2, 1], [1, 2, 3, 4]], "expected": [-1, 4, 3, 2]},
    {"name": "nums1 queries the smallest value in nums2", "args": [[1], [3, 1, 4, 2]], "expected": [4]},
    {"name": "nums1 queries the largest value in nums2", "args": [[4], [3, 1, 4, 2]], "expected": [-1]},
    {"name": "longer arrays", "args": [[2, 4, 6], [6, 5, 4, 3, 2, 1, 7]], "expected": [7, 7, 7]}
  ]
