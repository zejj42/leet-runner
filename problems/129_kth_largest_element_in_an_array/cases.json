{
  "function": "findKthLargest",
  "params": [
    {"name": "nums", "type": "integer[]"},
    {"name": "k", "type": "integer"}
  ],
  "returns": "integer",
  "compare": "exact",
  "cases": [
    {"name": "example 1", "args": [[3, 2, 1, 5, 6, 4], 2], "expected": 5},
    {"name": "example 2", "args": [[3, 2, 3, 1, 2, 4, 5, 5, 6], 4], "expected": 4},
    {"name": "k is the length, so the smallest", "args": [[4, 9, 1, 7], 4], "expected": 1},
    {"name": "the largest value twice", "args": [[8, 8, 3], 2], "expected": 8},
    {"name": "extreme values", "args": [[10000, -10000, 0], 3], "expected": -10000},
    {"name": "all equal, k in the middle", "args": [[6, 6, 6, 6, 6], 3], "expected": 6},
    {"name": "already descending", "args": [[9, 7, 5, 3, 1], 4], "expected": 3},
    {"name": "already ascending", "args": [[1, 3, 5, 7, 9], 4], "expected": 3},
    {"name": "values 1, k = 1", "args": [[1], 1], "expected": 1},
    {"name": "values 7 10 4 3 20 15, k = 3", "args": [[7, 10, 4, 3, 20, 15], 3], "expected": 10},
    {"name": "values 7 10 4 3 20 15, k = 4", "args": [[7, 10, 4, 3, 20, 15], 4], "expected": 7},
    {"name": "values 7 10 4 3 20 15, k = 5", "args": [[7, 10, 4, 3, 20, 15], 5], "expected": 4},
    {"name": "values -4 -1 -3 -2, k = 2", "args": [[-4, -1, -3, -2], 2], "expected": -2},
    {"name": "values 2 2 2, k = 2", "args": [[2, 2, 2], 2], "expected": 2},
    {"name": "values 2 1, k = 2", "args": [[2, 1], 2], "expected": 1},
    {"name": "values 1 2 3, k = 1", "args": [[1, 2, 3], 1], "expected": 3},
    {"name": "values 0 -1, k = 1", "args": [[0, -1], 1], "expected": 0},
    {"name": "values 1 2 3, k = 2", "args": [[1, 2, 3], 2], "expected": 2},
    {"name": "values 9 1 7 5, k = 3", "args": [[9, 1, 7, 5], 3], "expected": 5},
    {"name": "values 5 9 8 7 5, k = 2", "args": [[5, 9, 8, 7, 5], 2], "expected": 8},
    {"name": "values -5 -2 -9, k = 1", "args": [[-5, -2, -9], 1], "expected": -2},
    {"name": "values 4 1 7, k = 3", "args": [[4, 1, 7], 3], "expected": 1},
    {"name": "values 5 5 4, k = 2", "args": [[5, 5, 4], 2], "expected": 5},
    {"name": "values 1 2 6 3 4 7 5, k = 5", "args": [[1, 2, 6, 3, 4, 7, 5], 5], "expected": 3},
    {"name": "values -2 -1 0, k = 2", "args": [[-2, -1, 0], 2], "expected": -1},
    {"name": "values 5 4 3, k = 3", "args": [[5, 4, 3], 3], "expected": 3},
    {"name": "random small inputs", "file": "random.json.gz", "batch": true},
    {"name": "largest input, random values", "file": "large_input.json.gz", "large": true}
  ]
}
