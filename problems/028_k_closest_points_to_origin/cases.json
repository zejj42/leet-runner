{
  "function": "kClosest",
  "params": [
    {"name": "points", "type": "integer[][]"},
    {"name": "k", "type": "integer"}
  ],
  "returns": "integer[][]",
  "compare": "unordered",
  "cases": [
    {"name": "example 1", "args": [[[1, 3], [-2, 2]], 1], "expected": [[-2, 2]]},
    {"name": "example 2", "args": [[[3, 3], [5, -1], [-2, 4]], 2], "expected": [[3, 3], [-2, 4]]},
    {"name": "the origin itself is a point", "args": [[[0, 0], [3, 4]], 1], "expected": [[0, 0]]},
    {"name": "k takes every point", "args": [[[5, 5], [-1, 2], [0, -3]], 3], "expected": [[-1, 2], [0, -3], [5, 5]]},
    {"name": "points on the axes", "args": [[[0, 7], [-2, 0], [0, -1], [5, 0]], 2], "expected": [[0, -1], [-2, 0]]},
    {"name": "all four quadrants", "args": [[[1, 2], [-3, 1], [-1, -1], [4, -4]], 2], "expected": [[-1, -1], [1, 2]]},
    {"name": "corner of the allowed range", "args": [[[10000, 10000], [-10000, 9999], [1, 1]], 2], "expected": [[1, 1], [-10000, 9999]]},
    {"name": "the same point twice, both inside", "args": [[[2, 1], [2, 1], [6, 6]], 2], "expected": [[2, 1], [2, 1]]},
    {"name": "far point listed first", "args": [[[9, 9], [1, 0]], 1], "expected": [[1, 0]]},
    {"name": "points (1,2) (2,3) (4,6) (5,1), k = 3", "args": [[[1, 2], [2, 3], [4, 6], [5, 1]], 3], "expected": [[1, 2], [2, 3], [5, 1]]},
    {"name": "points (1,1) (-1,-1) (2,2) (-2,-2), k = 2", "args": [[[1, 1], [-1, -1], [2, 2], [-2, -2]], 2], "expected": [[1, 1], [-1, -1]]},
    {"name": "points (1,3) (3,4) (2,-1) (1,1), k = 3", "args": [[[1, 3], [3, 4], [2, -1], [1, 1]], 3], "expected": [[1, 1], [2, -1], [1, 3]]},
    {"name": "points (2,2), k = 1", "args": [[[2, 2]], 1], "expected": [[2, 2]]},
    {"name": "points (1,1) (1,1) (-1,1), k = 3", "args": [[[1, 1], [1, 1], [-1, 1]], 3], "expected": [[1, 1], [1, 1], [-1, 1]]},
    {"name": "points (-1,0) (2,0) (1,2), k = 1", "args": [[[-1, 0], [2, 0], [1, 2]], 1], "expected": [[-1, 0]]},
    {"name": "points (10,0) (9,0) (8,0) (1,0) (2,0), k = 2", "args": [[[10, 0], [9, 0], [8, 0], [1, 0], [2, 0]], 2], "expected": [[1, 0], [2, 0]]},
    {"name": "random small inputs", "file": "random.json.gz", "batch": true},
    {"name": "largest input, random points", "file": "large_input.json.gz", "large": true}
  ]
}
