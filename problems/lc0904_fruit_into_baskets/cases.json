    {"name": "three types, best run at the end", "args": [[2, 0, 1, 0, 1]], "expected": 4},
    {"name": "every tree a different type", "args": [[0, 1, 2, 3, 4]], "expected": 2},
    {"name": "second type introduced late", "args": [[0, 0, 0, 0, 1]], "expected": 5},
    {"name": "many types, one dominant pair repeating", "args": [[3, 3, 3, 1, 3, 3, 4, 3, 3]], "expected": 6},
