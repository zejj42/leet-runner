  "function": "trap",
  "params": [
    {"name": "height", "type": "integer[]"}
  ],
  "returns": "integer",
  "compare": "exact",
  "cases": [
    {"name": "example 1", "args": [[0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]], "expected": 6},
    {"name": "example 2", "args": [[4, 2, 0, 3, 2, 5]], "expected": 9},
    {"name": "single bar", "args": [[5]], "expected": 0},
    {"name": "single bar of zero height", "args": [[0]], "expected": 0},
    {"name": "two bars", "args": [[3, 1]], "expected": 0},
    {"name": "two equal bars", "args": [[4, 4]], "expected": 0},
    {"name": "all zeros", "args": [[0, 0, 0, 0, 0]], "expected": 0},
    {"name": "all bars equal", "args": [[3, 3, 3, 3, 3]], "expected": 0},
    {"name": "strictly increasing", "args": [[1, 2, 3, 4, 5]], "expected": 0},
    {"name": "strictly decreasing", "args": [[5, 4, 3, 2, 1]], "expected": 0},
    {"name": "single deep valley", "args": [[5, 0, 5]], "expected": 5},
    {"name": "valley at the very start", "args": [[0, 0, 5, 3, 5]], "expected": 2},
    {"name": "valley at the very end", "args": [[5, 3, 5, 0, 0]], "expected": 2},
    {"name": "many equal peaks with one dip between each", "args": [[5, 0, 5, 0, 5, 0, 5]], "expected": 15},
    {"name": "tallest bars allowed at both ends", "args": [[100000, 1, 0, 1, 100000]], "expected": 299998},
    {"name": "plateau then drop then rise", "args": [[4, 4, 4, 0, 4, 4]], "expected": 4},
    {"name": "largest input, random heights", "file": "large_random.json.gz", "large": true},
    {"name": "largest input, zigzag between zero and max height", "file": "large_zigzag.json.gz", "large": true}
  ]
}
