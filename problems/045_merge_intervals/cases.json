  "function": "merge",
  "params": [
    {"name": "intervals", "type": "integer[][]"}
  ],
  "returns": "integer[][]",
  "compare": "unordered",
  "cases": [
    {"name": "example 1", "args": [[[1, 3], [2, 6], [8, 10], [15, 18]]], "expected": [[1, 6], [8, 10], [15, 18]]},
    {"name": "example 2", "args": [[[1, 4], [4, 5]]], "expected": [[1, 5]]},
    {"name": "example 3", "args": [[[4, 7], [1, 4]]], "expected": [[1, 7]]},
    {"name": "single interval", "args": [[[3, 8]]], "expected": [[3, 8]]},
    {"name": "already sorted no overlap", "args": [[[1, 2], [3, 4], [5, 6]]], "expected": [[1, 2], [3, 4], [5, 6]]},
    {"name": "all equal intervals", "args": [[[2, 5], [2, 5], [2, 5]]], "expected": [[2, 5]]},
    {"name": "touching intervals", "args": [[[1, 2], [2, 3], [3, 4]]], "expected": [[1, 4]]},
    {"name": "unsorted input", "args": [[[15, 18], [1, 3], [8, 10], [2, 6]]], "expected": [[1, 6], [8, 10], [15, 18]]},
    {"name": "one interval contains another", "args": [[[1, 10], [2, 5]]], "expected": [[1, 10]]},
    {"name": "interval is a single point", "args": [[[5, 5], [1, 3]]], "expected": [[1, 3], [5, 5]]},
    {"name": "all intervals merge into one", "args": [[[1, 4], [2, 5], [3, 6], [4, 7]]], "expected": [[1, 7]]},
    {"name": "two disjoint groups", "args": [[[1, 3], [2, 4], [10, 12], [11, 14]]], "expected": [[1, 4], [10, 14]]},
    {"name": "large random overlapping intervals", "file": "large_input.json.gz", "large": true}
  ]
}
