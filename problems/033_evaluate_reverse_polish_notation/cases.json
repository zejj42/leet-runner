    {"name": "all four operators", "args": [["4", "2", "+", "3", "-", "5", "*", "2", "/"]], "expected": 7},
    {"name": "extreme token values", "args": [["200", "-200", "*"]], "expected": -40000},
    {"name": "chained multiplication of multi-digit numbers", "args": [["200", "200", "*", "200", "*", "200", "*"]], "expected": 1600000000},
    {"name": "equal numbers subtracted", "args": [["5", "5", "-"]], "expected": 0},
