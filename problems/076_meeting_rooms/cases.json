{
  "function": "canAttendMeetings",
  "params": [
    {"name": "intervals", "type": "integer[][]"}
  ],
  "returns": "boolean",
  "compare": "exact",
  "cases": [
    {"name": "example 1", "args": [[[0, 30], [5, 10], [15, 20]]], "expected": false},
    {"name": "example 2", "args": [[[7, 10], [2, 4]]], "expected": true},
    {"name": "empty list", "args": [[]], "expected": true},
    {"name": "single meeting", "args": [[[3, 8]]], "expected": true},
    {"name": "touching meetings", "args": [[[1, 2], [2, 3]]], "expected": true},
    {"name": "unsorted no overlap", "args": [[[10, 15], [1, 3], [5, 9]]], "expected": true},
    {"name": "identical meetings", "args": [[[2, 5], [2, 5]]], "expected": false},
    {"name": "nested meetings", "args": [[[1, 10], [2, 4]]], "expected": false},
    {"name": "partial overlap", "args": [[[1, 5], [4, 8]]], "expected": false},
    {"name": "many touching in a row", "args": [[[1, 2], [2, 3], [3, 4], [4, 5]]], "expected": true},
    {"name": "overlap at the end of the list", "args": [[[1, 2], [3, 4], [5, 6], [5, 20]]], "expected": false},
    {"name": "meetings [1,2] [2,3] [3,4]", "args": [[[1, 2], [2, 3], [3, 4]]], "expected": true},
    {"name": "meetings [1,3] [2,4] [4,6]", "args": [[[1, 3], [2, 4], [4, 6]]], "expected": false},
    {"name": "meetings [0,1] [3,5] [6,7]", "args": [[[0, 1], [3, 5], [6, 7]]], "expected": true},
    {"name": "meetings [10,20] [20,30] [30,40]", "args": [[[10, 20], [20, 30], [30, 40]]], "expected": true},
    {"name": "meetings [1,5] [6,10] [11,15]", "args": [[[1, 5], [6, 10], [11, 15]]], "expected": true},
    {"name": "meetings [5,10] [15,20] [10,15]", "args": [[[5, 10], [15, 20], [10, 15]]], "expected": true},
    {"name": "meetings [1,3] [2,4]", "args": [[[1, 3], [2, 4]]], "expected": false},
    {"name": "meetings [1,4] [1,4]", "args": [[[1, 4], [1, 4]]], "expected": false},
    {"name": "meetings [5,10] [1,6]", "args": [[[5, 10], [1, 6]]], "expected": false},
    {"name": "meetings [1,2] [3,5] [4,6]", "args": [[[1, 2], [3, 5], [4, 6]]], "expected": false},
    {"name": "meetings [4,8]", "args": [[[4, 8]]], "expected": true},
    {"name": "meetings [100,101] [20,21]", "args": [[[100, 101], [20, 21]]], "expected": true},
    {"name": "meetings [0,2] [0,1]", "args": [[[0, 2], [0, 1]]], "expected": false},
    {"name": "meetings [10,11] [0,9]", "args": [[[10, 11], [0, 9]]], "expected": true},
    {"name": "large non overlapping meetings", "file": "large_input.json.gz", "large": true}
  ]
}
